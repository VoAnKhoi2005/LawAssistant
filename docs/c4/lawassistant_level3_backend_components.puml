@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title LawAssistant - UI → Backend connections (actions to implement) (C4 Level 3)

Person(user, "End user", "Uses the app")

' FE exists but is not wired to BE yet: all relations below are PLANNED actions.
Container_Boundary(frontend, "Frontend (Flutter)") {
  Component(loginUi, "Login UI", "LoginPage", "TODO: call Auth APIs")
  Component(documentsUi, "Documents UI", "DocumentsPage", "TODO: list/create documents")
  Component(sectionsUi, "Sections UI", "SectionsPage", "TODO: load/search legal sections")
  Component(knowledgeGraphUi, "Knowledge Graph UI", "KnowledgeGraphPage", "TODO: load graph data")
}

System_Boundary(law, "LawAssistant") {

  Container_Boundary(api, "Backend API (FastAPI)") {
    Component(signInApi, "Sign In API", "Issue JWT access/refresh")
    Component(refreshApi, "Refresh Token API", "Refresh access token")
    Component(logoutApi, "Logout API", "Invalidate refresh token")

    Component(accountsApi, "User API", "Return current user profile")

    Component(documentsApi, "Documents API", "CRUD documents + queue processing")
    Component(uploadFilesApi, "Upload Files API", "Upload/download; manage file metadata")

    Component(legalSectionsApi, "Legal Sections API", "Browse/search legal sections")
    Component(conceptsApi, "Concepts API", "Concept nodes")
    Component(relationsApi, "Relations API", "Relation edges")
    Component(tripletsApi, "Triplets API", "Triplet facts")
    Component(sectionRelationsApi, "Section Relations API", "Section-to-section relations")

    Component(authMiddleware, "JWT auth dependency", "get_current_user")
    Component(exceptionHandling, "Exception handling", "Consistent errors")
  }

  Container_Boundary(worker, "Document Worker (Celery)") {
    Component(documentProcessingWorker, "Document Processing Worker", "Celery task: process_document", "Extract → simplify → extract triplets")
  }

  ContainerDb(mongo, "MongoDB", "MongoDB", "Users, documents, KG entities")
  ContainerDb(redis, "Redis", "Redis", "Refresh tokens + Celery broker/backend")

  System_Ext(openai, "OpenAI API", "Text simplification")
  System_Ext(gcp, "Google Cloud Vision + Storage", "OCR for PDFs")
  System_Ext(nlpModels, "Local NLP models", "VnCoreNLP + PhoNLP")
}

' --- UI usage ---
Rel(user, loginUi, "Uses")
Rel(user, documentsUi, "Uses")
Rel(user, sectionsUi, "Uses")
Rel(user, knowledgeGraphUi, "Uses")

' --- UI actions → BE APIs (PLANNED) ---
Rel(loginUi, signInApi, "Action: Sign in (TODO)", "JSON/HTTP")
Rel(loginUi, registerApi, "Action: Register (TODO)", "JSON/HTTP")
Rel(loginUi, refreshApi, "Action: Refresh session (TODO)", "JSON/HTTP")
Rel(loginUi, logoutApi, "Action: Logout (TODO)", "JSON/HTTP")
Rel(loginUi, accountsApi, "Action: Load current user (TODO)", "JSON/HTTP")

Rel(documentsUi, documentsApi, "Action: List documents (TODO)", "JSON/HTTP")
Rel(documentsUi, documentsApi, "Action: Create document (queue processing) (TODO)", "JSON/HTTP")
Rel(documentsUi, uploadFilesApi, "Action: Upload file(s) (TODO)", "multipart/HTTP")
Rel(documentsUi, uploadFilesApi, "Action: Track file status / download (TODO)", "JSON/HTTP")

Rel(sectionsUi, legalSectionsApi, "Action: List/search sections (TODO)", "JSON/HTTP")

Rel(knowledgeGraphUi, tripletsApi, "Action: Load triplets (TODO)", "JSON/HTTP")
Rel(knowledgeGraphUi, conceptsApi, "Action: Load concepts (TODO)", "JSON/HTTP")
Rel(knowledgeGraphUi, relationsApi, "Action: Load relations (TODO)", "JSON/HTTP")
Rel(knowledgeGraphUi, sectionRelationsApi, "Action: Load section relations (TODO)", "JSON/HTTP")

' --- Key backend dependencies (kept minimal) ---
Rel(signInApi, mongo, "Read user", "MongoDB")
Rel(signInApi, redis, "Store refresh token", "Redis")
Rel(refreshApi, redis, "Validate refresh token", "Redis")
Rel(logoutApi, redis, "Delete refresh token", "Redis")

Rel(documentsApi, mongo, "Read/write documents", "MongoDB")
Rel(documentsApi, redis, "Enqueue processing", "Celery/Redis")
Rel(uploadFilesApi, mongo, "Read/write file metadata", "MongoDB")

Rel(documentProcessingWorker, redis, "Consume tasks", "Celery/Redis")
Rel(documentProcessingWorker, mongo, "Write KG entities", "MongoDB")
Rel(documentProcessingWorker, gcp, "OCR PDFs", "HTTPS")
Rel(documentProcessingWorker, openai, "Simplify text", "HTTPS")
Rel(documentProcessingWorker, nlpModels, "Triplet extraction", "Local FS")

SHOW_LEGEND()
@enduml
