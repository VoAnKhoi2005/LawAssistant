# Copy to .env.docker or export these values in your shell before running Docker Compose.

DOCKER_OPENAI_API_KEY=your-openai-api-key
DOCKER_OPENAI_MODEL=gpt-4o-mini
DOCKER_GOOGLE_APPLICATION_CREDENTIALS=/opt/credentials/google-service-account.json
DOCKER_GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name
DOCKER_VNCORENLP_MODEL_PATH=/opt/models/VnCoreNLP-1.2
DOCKER_PHONLP_MODEL_PATH=/opt/models/phonlp
FRONTEND_API_BASE_URL=http://localhost:8000
