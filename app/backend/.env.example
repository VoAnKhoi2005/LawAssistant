# FastAPI backend and Celery worker configuration

# Database
# Use your local host for local runs, or the Compose service name when running in Docker.
MONGO_URI=mongodb://localhost:27017
DB_NAME=law_assistant

# Auth / JWT
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me-too
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis used by the API
# Use your local host for local runs, or the Compose service name when running in Docker.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Redis used by Celery / Flower
REDIS_URL=redis://localhost:6379/0

# Worker settings
WORKER_CONCURRENCY=2
# Set to true only when you want the API process to launch a local worker too.
AUTO_START_WORKER=false

# External services
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# Local NLP assets
VNCORENLP_MODEL_PATH=/absolute/path/to/VnCoreNLP-1.2
PHONLP_MODEL_PATH=/absolute/path/to/phonlp
